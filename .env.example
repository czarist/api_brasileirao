# Copy to .env for local runs. Compose supplies its own development values.
# DATABASE_URL is required. Do not commit a real .env file.

DATABASE_URL=postgres://brasileirao:brasileirao@127.0.0.1:5432/brasileirao?sslmode=disable
# Host port published by Compose. Containers keep using postgres:5432.
POSTGRES_PORT=5432
HTTP_ADDR=:8080
LOG_LEVEL=info

# HTTP server
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
TRUST_PROXY=false

# Source. Only this origin is requested, and only through fixed paths.
SOURCE_BASE_URL=https://www.cbf.com.br
SOURCE_TIMEOUT=30s
SOURCE_MIN_INTERVAL=1s
SOURCE_MAX_BODY_BYTES=8000000
SOURCE_RETRIES=2

# Worker. SYNC_COMPETITION is one code, a comma-separated list, or all.
# Codes: brasileirao-serie-a, brasileirao-serie-b, brasileirao-serie-c, brasileirao-serie-d.
# SYNC_YEARS=all collects every year the catalog lists. Otherwise SYNC_YEAR is used.
# SYNC_YEAR=0 means the current year in America/Sao_Paulo. A -year flag overrides both.
# The four divisions use their own match and standings limits. The three values below
# are the fallback for a competition without a built-in limit.
SYNC_INTERVAL=1h
SYNC_TIMEOUT=2m
SYNC_COMPETITION=brasileirao-serie-a
SYNC_YEAR=0
# SYNC_YEARS=all
STALE_AFTER=6h
SYNC_MIN_MATCHES=100
SYNC_MIN_STANDINGS=18
SYNC_MAX_STANDINGS=22

DB_MAX_CONNS=10
